# Required: Anthropic Claude API key (for role classification + punctuation polish).
# Get one at https://console.anthropic.com/. Set LLM_ENABLED=false in config.json to skip these steps.
ANTHROPIC_API_KEY=sk-ant-...

# Required for pyannote diarization (first run downloads the model).
# Get a free token at https://huggingface.co/settings/tokens
# Also visit https://huggingface.co/pyannote/speaker-diarization-3.1 and accept the user conditions.
HF_TOKEN=hf_...

# Optional: post completion / failure notifications to a Slack channel.
# Create an Incoming Webhook at https://api.slack.com/messaging/webhooks
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# Optional overrides (defaults shown):
# PORT=8901
# HOST=127.0.0.1
# DEFAULT_USER=local
# PUBLIC_URL=http://localhost:8901
# DB_PATH=./data/jobs.db
